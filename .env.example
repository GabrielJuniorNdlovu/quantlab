# Copy to .env, choose a local-only password, and fill in the matching database URL.
# Never commit .env or a real connection URL. Use a URL-encoded password in URLs.
POSTGRES_USER=quantlab
POSTGRES_DB=quantlab
POSTGRES_PASSWORD=
QUANTLAB_DB_PORT=15432

# Format: postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:PORT/DATABASE
QUANTLAB_DATABASE_URL=
QUANTLAB_ARCHIVE_DIR=raw-archive

# Set only for an isolated test database. Tests must never target valuable data.
QUANTLAB_TEST_DATABASE_URL=
